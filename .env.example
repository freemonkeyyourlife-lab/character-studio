# Server-side Hugging Face token. Never expose this as NEXT_PUBLIC_*.
HF_TOKEN=
# Text-to-image model.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Image+text editing / reference model.
HF_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# Optional cloud persistence. Leave empty to keep browser-local MVP behavior.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=