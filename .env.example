# Server-side Hugging Face token. Never expose this as NEXT_PUBLIC_*.
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# Optional provider credentials.
REPLICATE_API_TOKEN=
FAL_KEY=
REPLICATE_VIDEO_MODEL=
FAL_VIDEO_MODEL=

# ComfyUI local/self-hosted HTTP endpoint.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
# Optional ComfyUI video workflow JSON. Use {{PROMPT}}, {{DURATION}}, {{WIDTH}}, {{HEIGHT}}, {{FPS}} placeholders.
COMFYUI_VIDEO_WORKFLOW=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
